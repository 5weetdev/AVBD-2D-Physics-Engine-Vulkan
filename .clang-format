# Matches the existing tree (Allman braces, 4 spaces, right-aligned pointers).
# Do NOT run a repo-wide reformat: format only lines you touch (git clang-format).
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Allman
PointerAlignment: Right
AccessModifierOffset: -4
NamespaceIndentation: None
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
SortIncludes: Never        # include order is deliberate (bare basenames, generated *_spirv.h)
ReflowComments: false
